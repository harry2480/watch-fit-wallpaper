{
	"name": "watchfit",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.18.1",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:unit",
		"merge": "bash scripts/merge-pr.sh",
		"prepare": "simple-git-hooks",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint:fix",
		"pre-push": "pnpm verify"
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.76.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.1",
		"zod": "4.6.7"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"simple-git-hooks"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@vitest/browser-playwright": "5.1.1",
		"jsdom": "31.0.1",
		"playwright": "1.65.1",
		"simple-git-hooks": "2.14.0",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"engines": {
		"node": ">=22.22.2"
	}
}
